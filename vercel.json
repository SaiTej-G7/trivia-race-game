{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/expired-rooms",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/socket-io.js": {
      "maxDuration": 60
    },
    "api/cron/expired-rooms.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/socket.io/:path*",
      "destination": "/api/socket-io"
    }
  ]
}